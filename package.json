{
  "name": "openfray-compendium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Compendium data-generation tooling for OpenFray — ingests SRD and third-party sources into OpenFray's Creature schema, validates the output, and emits the JSON the app ships.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "ingest:srd-2014": "node scripts/ingest-srd-2014.ts",
    "ingest:srd52": "node scripts/ingest-srd52.ts",
    "ingest:srd52-spells": "node scripts/ingest-srd52-spells.ts",
    "ingest:brood-and-bloom": "node scripts/ingest-brood-and-bloom.ts",
    "ingest:brood-and-bloom-spells": "node scripts/ingest-brood-and-bloom-spells.ts",
    "ingest:strong-waters-spells": "node scripts/ingest-strong-waters-spells.ts",
    "ingest:waking-garden": "node scripts/ingest-waking-garden.ts",
    "ingest:khyberia": "node scripts/ingest-khyberia.ts",
    "prepare:open5e": "node scripts/prepare-open5e.ts",
    "prepare:open5e-spells": "node scripts/prepare-open5e-spells.ts",
    "prepare:tome-of-heroes-spells": "node scripts/prepare-tome-of-heroes-spells.ts",
    "prepare:deep-magic-2020-spells": "node scripts/prepare-deep-magic-2020-spells.ts",
    "review:warlock-grimoire": "node scripts/review-warlock-grimoire.ts",
    "prepare:warlock-grimoire-spells": "node scripts/prepare-warlock-grimoire-spells.ts",
    "prepare:stds-spells": "node scripts/prepare-spells-that-dont-suck.ts",
    "prepare:so-many-spells": "node scripts/prepare-so-many-spells.ts",
    "prepare:kibbles-v23-spells": "node scripts/prepare-kibbles-v23-spells.ts",
    "export:reference-spells": "node scripts/export-reference-spells.ts",
    "validate": "node scripts/validate-compendium.ts",
    "estimate:cr": "node scripts/estimate-cr.ts",
    "schema:check": "node scripts/schema-sync.ts --check",
    "schema:sync": "node scripts/schema-sync.ts --sync",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:python": "node scripts/verify.mjs --python-only",
    "verify": "node scripts/verify.mjs",
    "verify:offline": "node scripts/verify-offline.ts",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "check:prose": "node scripts/check-prose.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "parse5": "^8.0.1",
    "prettier": "3.9.10",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  }
}
